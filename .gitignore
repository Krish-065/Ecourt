# Dependencies
node_modules/
*/node_modules/
jspm_packages/
web_modules/

# Next.js & Frontend Build Outputs
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
*.tsbuildinfo
.open-next/

# Environment Files & Secret Keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Python & AI Microservice
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
huggingface/
.cache/
models/
*.pt
*.bin
*.onnx

# Database, Runtime & Vault Storage
storage/*
!storage/.gitkeep
database/data/
pgdata/
redis/data/
*.sqlite
*.sqlite3

# IDE / Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# OS Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Logs & Diagnostics
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
